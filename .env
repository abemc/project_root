# Redis Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=esp_secure_password
REDIS_DB=0

# RAG Settings
RAG_CACHE_ENABLED=true
RAG_CACHE_TTL=3600
EMBEDDING_DEVICE=cpu
RERANKER_DEVICE=cpu

# OpenAI API Settings
USE_OPENAI_API=true
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

